@page "/products"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

@using cse325_finalproject.Models
@inject cse325_finalproject.Services.ProductService ProductService
@inject cse325_finalproject.Services.CategoryService CategoryService

<PageTitle>Products</PageTitle>

<h3>Products</h3>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">
        @errorMessage
    </div>
}

@if (!string.IsNullOrEmpty(successMessage))
{
    <div class="alert alert-success">
        @successMessage
    </div>
}

<div class="row g-3 mb-3">
    <div class="col-12 col-lg-8">
        <div class="input-group">
            <input class="form-control" type="search" placeholder="Search by name, description, or category..."
                   aria-label="Search products" @bind="searchTerm" @bind:event="oninput" @onkeydown="HandleKeyDown" />
            <button class="btn btn-primary" type="button" @onclick="Search">
                Search
            </button>
            @if (!string.IsNullOrWhiteSpace(searchTerm))
            {
                <button class="btn btn-outline-secondary" type="button" @onclick="ClearSearch">
                    Clear
                </button>
            }
        </div>
    </div>
</div>

<h4>
    @(isEditing ? "Edit Product" : "Add Product")
</h4>

<div class="row g-3 mb-4">
    <div class="col-12 col-md-6">
        <label class="form-label">
            Product Name
        </label>
        <input class="form-control" @bind="newProduct.Name" />
    </div>

    <div class="col-12 col-md-6">
        <label class="form-label">
            Description
        </label>
        <input class="form-control" @bind="newProduct.Description" />
    </div>

    <div class="col-6 col-md-3 col-lg-3">
        <label class="form-label">
            Price
        </label>
        <input type="number" class="form-control" min="0" step="0.01" @bind="newProduct.Price" />
    </div>

    <div class="col-6 col-md-3 col-lg-3">
        <label class="form-label">
            Quantity
        </label>
        <input type="number" class="form-control" min="0" @bind="newProduct.Quantity" />
    </div>

    <div class="col-12 col-md-6 col-lg-6">
        <label class="form-label">
            Category
        </label>
        <select class="form-select" @bind="newProduct.CategoryId">
            <option value="0">
                Select Category
            </option>

            @foreach (var category in categories)
            {
                <option value="@category.Id">
                    @category.Name
                </option>
            }
        </select>
    </div>

    <div class="col-12">
        @if (isEditing)
        {
            <button class="btn btn-success" @onclick="UpdateProduct">
                Update Product
            </button>

            <button class="btn btn-secondary ms-2" @onclick="CancelEdit">
                Cancel
            </button>
        }
        else
        {
            <button class="btn btn-primary" @onclick="AddProduct">
                Add Product
            </button>
        }
    </div>
</div>

@if (products == null)
{
    <p>Loading products...</p>
}
else if (products.Count == 0)
{
    if (hasSearched)
    {
        <p>No results found for "<strong>@searchTerm</strong>".</p>
    }
    else
    {
        <p>No products available.</p>
    }
}
else
{
    <p>
        Showing <strong>@products.Count</strong> product(s)
        @if (hasSearched)
        {
            <span>for "<strong>@searchTerm</strong>"</span>
        }
    </p>

    <div class="table-responsive">

        <table class="table table-striped table-hover">

            <thead>
                <tr>
                    <th>
                        Name
                    </th>

                    <th>
                        Price
                    </th>

                    <th>
                        Quantity
                    </th>

                    <th>
                        Category
                    </th>
                    <th>
                        Actions
                    </th>
                </tr>
            </thead>

            <tbody>

                @foreach (var product in products)
                {
                    <tr>

                        <td>
                            @product.Name
                        </td>

                        <td>
                            @product.Price.ToString("C2", System.Globalization.CultureInfo.GetCultureInfo("en-US"))
                        </td>

                        <td>
                            @product.Quantity
                        </td>

                        <td>
                            @product.Category?.Name
                        </td>

                        <td>

                            <button class="btn btn-warning btn-sm me-2" @onclick="() => StartEdit(product)">
                                Edit
                            </button>

                            <button class="btn btn-danger btn-sm" @onclick="() => ConfirmDelete(product)">
                                Delete
                            </button>

                        </td>
                    </tr>
                }

            </tbody>

        </table>

    </div>
}

@if (showDeleteConfirmation)
{
    <div class="alert alert-warning">

        <p>
            Are you sure you want to delete
            <strong>@productToDeleteName</strong>?
        </p>

        <button class="btn btn-danger me-2" @onclick="DeleteProduct">
            Delete
        </button>

        <button class="btn btn-secondary" @onclick="CancelDelete">
            Cancel
        </button>

    </div>
}

@code
{
    private List<Product>? products;

    private Product newProduct = new();

    private List<Category> categories = new();

    private string searchTerm = "";

    private bool hasSearched = false;

    private string errorMessage = "";

    private string successMessage = "";

    private bool isEditing = false;

    private int editingProductId;

    private bool showDeleteConfirmation = false;

    private int productToDeleteId;

    private string productToDeleteName = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadCategories();
        await LoadProducts();
    }

    private async Task LoadCategories()
    {
        categories = await CategoryService.GetCategoriesAsync();
    }

    private async Task LoadProducts()
    {
        products = await ProductService.SearchProductsAsync(searchTerm);
    }

    private async Task Search()
    {
        await LoadProducts();
    }

    private async Task ClearSearch()
    {
        searchTerm = "";
        hasSearched = false;
        await LoadProducts();
    }

    private async Task HandleKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await LoadProducts();
        }
    }

    private void ClearMessages()
    {
        errorMessage = "";
        successMessage = "";
    }

    private void StartEdit(Product product)
    {
        isEditing = true;

        editingProductId = product.Id;

        newProduct = new Product
        {
            Id = product.Id,
            Name = product.Name,
            Description = product.Description,
            Price = product.Price,
            Quantity = product.Quantity,
            CategoryId = product.CategoryId
        };

        ClearMessages();
    }

    private async Task UpdateProduct()
    {
        ClearMessages();

        if (ValidateProduct())
        {
            await ProductService.UpdateProductAsync(newProduct);

            isEditing = false;

            newProduct = new Product();

            successMessage = "Product updated successfully.";

            await LoadProducts();
        }
    }

    private void CancelEdit()
    {
        isEditing = false;

        newProduct = new Product();

        ClearMessages();
    }

    private async Task DeleteProduct()
    {
        await ProductService.DeleteProductAsync(productToDeleteId);

        showDeleteConfirmation = false;

        successMessage = "Product deleted successfully.";

        await LoadProducts();
    }

    private void CancelDelete()
    {
        showDeleteConfirmation = false;
    }

    private void ConfirmDelete(Product product)
    {
        productToDeleteId = product.Id;

        productToDeleteName = product.Name;

        showDeleteConfirmation = true;
    }

    private bool ValidateProduct()
    {
        errorMessage = "";

        if (string.IsNullOrWhiteSpace(newProduct.Name))
        {
            errorMessage = "Product name is required.";
            return false;
        }

        if (newProduct.CategoryId == 0)
        {
            errorMessage = "Please select a category.";
            return false;
        }

        if (newProduct.Price <= 0)
        {
            errorMessage = "Price must be greater than zero.";
            return false;
        }

        if (newProduct.Quantity < 0)
        {
            errorMessage = "Quantity cannot be negative.";
            return false;
        }

        return true;
    }

    private async Task AddProduct()
    {
        ClearMessages();

        if (ValidateProduct())
        {
            await ProductService.AddProductAsync(newProduct);

            newProduct = new Product();

            successMessage = "Product added successfully.";

            await LoadProducts();
        }
    }
}
